# Configure on the server only. Never put this key in the React app or Android package.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FIO_TRANSCRIPTION_MODEL=gpt-transcribe
FIO_DATA_DIR=./server/data
FIO_MAX_UPLOAD_MB=500
FIO_MAX_UNPACKED_MB=2048
FIO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
